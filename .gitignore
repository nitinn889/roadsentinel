# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# Virtual environments
# ============================================================
.venv/
venv/
carla_env/

# ============================================================
# IDE
# ============================================================
.vscode/
.idea/

# ============================================================
# Hugging Face / ML caches
# ============================================================
.cache/
cache/
huggingface/
hf_cache/

# ============================================================
# Existing ML datasets
# ============================================================
ml/data/*

# Keep small/reference project data
!ml/data/healthy_road/
!ml/data/test_road/
!ml/data/healthy_road/.gitkeep
!ml/data/test_road/.gitkeep

# ============================================================
# Large/generated model files
# ============================================================
ml/models/*.npy
ml/models/*.pt
ml/models/*.pth
ml/models/*.bin
ml/models/*.safetensors

# Ignore model/checkpoint formats globally
*.pt
*.pth
*.onnx
*.engine
*.ckpt
*.safetensors

# ============================================================
# Existing ML generated outputs
# ============================================================
ml/outputs/*
!ml/outputs/.gitkeep

# ============================================================
# Root-level generated outputs / training caches
# ============================================================
/outputs/
/output/
/runs/
/checkpoints/

# ============================================================
# Main downloaded datasets
# ============================================================
RoadSentinel_datasets/

# ============================================================
# YOLO
# ============================================================

# Do not commit downloaded/raw datasets
yolo/datasets/

# Do not commit prepared image/label copies
yolo/data/images/
yolo/data/labels/

# Dataset / Ultralytics caches
yolo/data/**/*.cache
yolo/**/*.cache

# Training runs/checkpoints
yolo/runs/
yolo/checkpoints/

# Ignore generated/intermediate weights by default
yolo/weights/*.pt
yolo/weights/*.pth
yolo/weights/*.onnx
yolo/weights/*.engine
yolo/weights/*.ckpt

# Large/raw YOLO output directories
yolo/outputs/predictions/
yolo/outputs/temp/
yolo/outputs/debug/
yolo/outputs/runs/
yolo/outputs/train/
yolo/outputs/train*/
yolo/outputs/val/
yolo/outputs/val*/

# Keep small useful files inside yolo/outputs/
# such as metrics CSV/JSON, summaries and research plots.

# ============================================================
# XGBoost
# ============================================================

# Raw externally downloaded data
xgboost/data/raw/

# Temporary/cache data
xgboost/cache/
xgboost/tmp/

# IMPORTANT:
# XGBoost JSON models/configs/processed CSVs/results remain tracked.
# Example:
# xgboost/model/model_v1.json
# xgboost/model/scenario_model_v2.json
# xgboost/config/*.json
# xgboost/outputs/*.json
# xgboost/outputs/*.csv

# ============================================================
# DINOv2 + SAM2
# ============================================================

# Large downloaded checkpoints/models
sam2_dino/checkpoints/
sam2_dino/models/
sam2_dino/cache/

# Raw datasets
sam2_dino/datasets/

# Generated per-image artifacts
sam2_dino/outputs/*/

# Keep top-level machine-readable summaries
!sam2_dino/outputs/*.json
!sam2_dino/outputs/*.csv
!sam2_dino/outputs/*.md
!sam2_dino/outputs/.gitkeep

# ============================================================
# road_health_pipeline generated data
# ============================================================

road_health_pipeline/output/generated/
road_health_pipeline/output/temp/
road_health_pipeline/output/debug/

# Large memory-bank artifacts
road_health_pipeline/output/real_memory_bank/

# Large model/checkpoint folders
road_health_pipeline/checkpoints/
road_health_pipeline/models/checkpoints/

# ============================================================
# CARLA / environment generated content
# ============================================================
env/__pycache__/
env/output/
env/carla_env/
env/Blender files/
env/assets/
env/road_defects_preview/
env/*.jpg

# ============================================================
# Unreal Engine generated folders
# ============================================================
RoadSentinelSim/Intermediate/
RoadSentinelSim/Binaries/
RoadSentinelSim/Saved/
RoadSentinelSim/DerivedDataCache/

# ============================================================
# ML / experiment temporary files
# ============================================================
events.out.tfevents.*
*.tfevents.*
*.npy
*.npz
*.pkl

# ============================================================
# Archives / downloaded installers
# ============================================================
*.zip
*.tar
*.tar.gz
*.7z
*.whl

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db

# ============================================================
# Secrets
# ============================================================
.env
*.pem
*.key

# ============================================================
# IMPORTANT: FINAL YOLO MODEL REQUIRED FOR DEMO
# ============================================================

# Override the global *.pt ignore rule for ONLY the final
# road-defect YOLO checkpoint used by RoadSentinel.
!yolo/weights/best.pt
